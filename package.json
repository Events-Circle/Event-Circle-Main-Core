{
  "name": "events-circle",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "test": "pnpm --filter @events-circle/backend test",
    "generate": "pnpm --filter @events-circle/backend db:generate",
    "contracts": "pnpm --filter @events-circle/backend contracts && pnpm --filter @events-circle/api-client generate",
    "check": "pnpm lint && pnpm generate && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "turbo run dev",
    "keys": "node scripts/keys.mjs"
  },
  "devDependencies": {
    "turbo": "^2.8.0",
    "typescript": "^5.9.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.55.0",
    "prettier": "^3.8.0",
    "@types/node": "^22.0.0"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "multer": "2.3.0",
      "xcode>uuid": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "type": "module"
}
