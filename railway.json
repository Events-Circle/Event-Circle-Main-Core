{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "infrastructure/docker/backend.Dockerfile" },
  "deploy": {
    "startCommand": "node /app/scripts/staging-start.mjs",
    "healthcheckPath": "/api/v1/core/health/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1
  }
}
