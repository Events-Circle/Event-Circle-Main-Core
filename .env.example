NODE_ENV=development
HOST=127.0.0.1
CORE_PORT=4000
GROWTH_PORT=4001
CORE_DATABASE_URL=postgresql://core:local-core-password@127.0.0.1:5432/core
GROWTH_DATABASE_URL=postgresql://growth:local-growth-password@127.0.0.1:5433/growth
JWT_ISSUER=http://localhost:4000
JWT_AUDIENCE=events-circle
JWT_KEY_ID=local-v1
JWT_PRIVATE_KEY_PATH=.secrets/private.pem
JWT_PUBLIC_KEY_PATH=.secrets/public.pem
CORE_API_URL=http://127.0.0.1:4000
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
# Explicit trusted proxy CIDRs only. Empty by default; never use true or *.
TRUST_PROXY_CIDRS=
