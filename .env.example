NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://circle:local-development-only@127.0.0.1:5432/events_circle
JWT_ISSUER=http://localhost:4000
JWT_AUDIENCE=events-circle
JWT_KEY_ID=local-v1
JWT_PRIVATE_KEY_PATH=../.secrets/private.pem
JWT_PUBLIC_KEY_PATH=../.secrets/public.pem
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
EDITION=growth-os
# Optional subset of the edition: presence,leads. Disabled routes are not registered.
ENABLED_MODULES=presence,leads
TRUST_PROXY_CIDRS=
# Enable only after idempotent in-process event consumers have been registered.
OUTBOX_WORKER_ENABLED=false
NEXT_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
