  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "TokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number"
          },
          "tokenType": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn",
          "tokenType"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "SupplierDto": {
        "type": "object",
        "properties": {
          "businessName": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "serviceAreas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptInquiries": {
            "type": "object"
          }
        },
        "required": [
          "businessName",
          "category",
          "city"
        ]
      },
      "SupplierResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "businessName": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "serviceAreas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptInquiries": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "organizationId",
          "businessName",
          "category",
          "city",
          "serviceAreas",
          "acceptInquiries"
        ]
      },
      "PreferencesDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "boolean"
          },
          "push": {
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "push"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "notificationPreferences": {
            "$ref": "#/components/schemas/PreferencesDto"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "locale",
          "timezone",
          "notificationPreferences"
        ]
      },
      "ProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "ar",
              "fr"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "notificationPreferences": {
            "$ref": "#/components/schemas/PreferencesDto"
          }
        }
      },
      "OrganizationNameDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "MembershipDto": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "EDITOR",
              "VIEWER"
            ]
          },
          "organization": {
            "$ref": "#/components/schemas/OrganizationNameDto"
          }
        },
        "required": [
          "organizationId",
          "role",
          "organization"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "id": {
