generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String         @id @default(uuid()) @db.Uuid
  email                   String         @unique
  passwordHash            String
  displayName             String
  locale                  String         @default("en")
  timezone                String         @default("UTC")
  notificationPreferences Json           @default("{\"email\":false,\"push\":false}")
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  memberships             Membership[]
  sessions                Session[]
  consents                Consent[]
  subscriptions           Subscription[]
  notifications           Notification[]

  @@map("core_users")
}

model Session {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime       @default(now())
  tokens    RefreshToken[]

  @@index([userId, revokedAt])
  @@map("core_sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("core_refresh_tokens")
}

model Consent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String
  version    String
  granted    Boolean
  recordedAt DateTime @default(now())

  @@index([userId, purpose, recordedAt])
  @@map("core_consents")
}

model Subscription {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode          String
  status            String
  provider          String
  providerReference String   @unique
  features          String[]
  startsAt          DateTime
  endsAt            DateTime
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([userId, status, endsAt])
  @@map("core_subscriptions")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("core_notifications")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid
  action        String
  targetId      String?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@map("core_audit_logs")
}

enum MemberRole {
  OWNER
  EDITOR
  VIEWER
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  supplier    Supplier?
  media       CoreMedia[]

  @@map("core_organizations")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           MemberRole   @default(VIEWER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("core_memberships")
}

model Supplier {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @unique @db.Uuid
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessName      String
  category          String
  city              String
  serviceAreas      String[]
  acceptInquiries   Boolean           @default(false)
  contactEmail      String?
  contactPhone      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  presenceProfiles  PresenceProfile[]
  leadOpportunities LeadOpportunity[]
  presenceContent   PresenceContent[]
  categoryId        String?           @db.Uuid
  categoryEntry     CoreCatalog?      @relation("SupplierCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  locationId        String?           @db.Uuid
  locationEntry     CoreCatalog?      @relation("SupplierLocation", fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  @@map("core_suppliers")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  organizationId String    @db.Uuid
  payload        Json
  correlationId  String
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lockedUntil    DateTime?
  claimToken     String?   @db.Uuid
  lastError      String?

  @@index([deliveredAt, createdAt])
  @@map("core_outbox_events")
}

// Presence owns this table; canonical business identity stays in Core.
model PresenceProfile {
  id             String     @id @default(uuid()) @db.Uuid
  supplierId     String     @unique @db.Uuid
  supplier       Supplier   @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  slug           String     @unique
  description    String     @default("")
  published      Boolean    @default(false)
  updatedAt      DateTime   @updatedAt
  tagline        String     @default("")
  showEmail      Boolean    @default(false)
  showPhone      Boolean    @default(false)
  logoMediaId    String?    @db.Uuid
  logo           CoreMedia? @relation("PresenceLogo", fields: [logoMediaId], references: [id], onDelete: Restrict)
  coverMediaId   String?    @db.Uuid
  cover          CoreMedia? @relation("PresenceCover", fields: [coverMediaId], references: [id], onDelete: Restrict)
  seoTitle       String     @default("")
  seoDescription String     @default("")
  accentColor    String     @default("#2563eb")
  socialLinks    Json       @default("[]")
  openingHours   Json       @default("[]")
  categoryDetails Json      @default("{\"type\":\"GENERAL\",\"values\":{}}")
  sections       String[]   @default(["portfolio", "listings", "gallery"])
  publishedAt    DateTime?
  version        Int        @default(1)

  @@map("presence_profiles")
}

enum CatalogKind {
  CATEGORY
  LOCATION
}

model CoreCatalog {
  id                 String            @id @default(uuid()) @db.Uuid
  kind               CatalogKind
  label              String
  active             Boolean           @default(true)
  contentCategories  PresenceContent[] @relation("ContentCategory")
  contentLocations   PresenceContent[] @relation("ContentLocation")
  supplierCategories Supplier[]        @relation("SupplierCategory")
  supplierLocations  Supplier[]        @relation("SupplierLocation")

  @@unique([kind, label])
  @@map("core_catalogs")
}

model CoreMedia {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  objectKey      String                 @unique
  mimeType       String                 @default("image/webp")
  width          Int
  height         Int
  bytes          Int
  createdAt      DateTime               @default(now())
  logos          PresenceProfile[]      @relation("PresenceLogo")
  covers         PresenceProfile[]      @relation("PresenceCover")
  attachments    PresenceContentMedia[]

  @@index([organizationId, createdAt])
  @@map("core_media")
}

enum PresenceContentKind {
  PORTFOLIO
  LISTING
  GALLERY
}

enum PresenceContentStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum PresenceListingType {
  SERVICE
  PRODUCT
  PACKAGE
  OFFER
}

enum PresencePricingMode {
  FIXED
  FROM
  ON_REQUEST
  FREE
}

model PresenceContent {
  id               String                 @id @default(uuid()) @db.Uuid
  supplierId       String                 @db.Uuid
  supplier         Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  kind             PresenceContentKind
  title            String
  summary          String                 @default("")
  description      String                 @default("")
  categoryId       String?                @db.Uuid
  category         CoreCatalog?           @relation("ContentCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  locationId       String?                @db.Uuid
  location         CoreCatalog?           @relation("ContentLocation", fields: [locationId], references: [id], onDelete: Restrict)
  occurredAt       DateTime?
  type             PresenceListingType?
  pricingMode      PresencePricingMode?
  priceUnit        String?
  inclusions       String[]             @default([])
  pricingNote      String               @default("")
  amountMinor      Int?
  currency         String?
  validFrom        DateTime?
  validUntil       DateTime?
  serviceAreas     String[]               @default([])
  availabilityNote String                 @default("")
  featured         Boolean                @default(false)
  status           PresenceContentStatus  @default(DRAFT)
  displayOrder     Int                    @default(0)
  version          Int                    @default(1)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  publishedAt      DateTime?
  media            PresenceContentMedia[]

  @@index([supplierId, kind, status, displayOrder, id])
  @@map("presence_content")
}

model PresenceContentMedia {
  id           String          @id @default(uuid()) @db.Uuid
  contentId    String          @db.Uuid
  content      PresenceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  mediaId      String          @db.Uuid
  media        CoreMedia       @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  role         String
  altText      String
  caption      String          @default("")
  displayOrder Int

  @@unique([contentId, mediaId])
  @@map("presence_content_media")
}

enum LeadStage {
  NEW
  HOT
  FOLLOW_UP
  QUALIFIED
  WON
  LOST
}

model LeadOpportunity {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @db.Uuid
  supplierId            String    @db.Uuid
  supplier              Supplier  @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  name                  String
  email                 String?
  phone                 String?
  message               String
  stage                 LeadStage @default(NEW)
  source                String    @default("DIRECT")
  campaign              String?
  contactConsent        Boolean
  contactConsentVersion String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([organizationId, createdAt])
  @@map("lead_opportunities")
}
