generator client {
  provider = "prisma-client-js"
  output = "../../generated/growth"
}
datasource db {
  provider = "postgresql"
  url = env("GROWTH_DATABASE_URL")
}
enum LeadStage {
  NEW
  HOT
  FOLLOW_UP
  QUALIFIED
  WON
  LOST
}
model Supplier {
  id String @id @default(uuid()) @db.Uuid
  coreUserId String @unique @db.Uuid
  slug String @unique
  businessName String
  description String @default("")
  category String
  city String
  serviceAreas String[]
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads Lead[]
}
model Lead {
  id String @id @default(uuid()) @db.Uuid
  supplierId String @db.Uuid
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name String
  email String?
  phone String?
  message String
  stage LeadStage @default(NEW)
  source String @default("PUBLIC_PROFILE")
  campaign String?
  contactConsent Boolean
  contactConsentVersion String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([supplierId, createdAt])
  @@index([supplierId, stage])
}
model Activity {
  id String @id @default(uuid()) @db.Uuid
  coreUserId String @db.Uuid
  action String
  targetId String
  createdAt DateTime @default(now())
  @@index([coreUserId, createdAt])
}
